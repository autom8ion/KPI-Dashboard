# Copy to .env. `docker compose` reads this both for its own variable
# substitution (DEVLAKE_TAG below) and, via `env_file:`, as the DevLake
# container's runtime config -- the "Lake core" section is DevLake's own
# env.example (release v1.0.3-beta16), unmodified, plus a QA-KPI-Dashboard
# section for qa_collector, GitHub, and (optional) Jira/Slack/reporting.

########################
# DevLake image version #
########################
DEVLAKE_TAG=v1.0.3-beta16

#################################################
# QA-KPI-Dashboard additions (qa_collector, bootstrap scripts, reporting)
#################################################

# Required for live ingestion (real GitHub Actions test results + DORA data
# via DevLake's GitHub plugin). A fine-grained PAT with read access to
# autom8ion/playwright-agentic, k6-agentic, backend-agentic, KPI-Dashboard
# (contents + actions + metadata) is enough. Leave blank to run `make demo`
# on seeded data only.
GITHUB_TOKEN=
GITHUB_ORG=autom8ion

# Optional: point DevLake's Jira plugin at a real Jira Cloud/Server instance
# instead of seeded data. See docs/dora-metrics.md "Swapping in real Jira".
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# qa_collector's own database (qa-postgres service below). The 5433 host
# port (container's 5432 is unchanged) avoids clashing with a local Postgres.
QA_POSTGRES_DSN=postgresql://qa:qa@localhost:5433/qa_metrics

# DevLake's config API + Grafana, used by devlake/scripts/bootstrap.sh and
# the qa-kpi-report skill. Defaults match docker-compose.yml's port mapping.
DEVLAKE_API_URL=http://localhost:8080
DEVLAKE_GRAFANA_URL=http://localhost:3002

# Optional: qa-kpi-report workflow posts to Slack in addition to committing
# reports/*.md. Leave blank to skip.
SLACK_WEBHOOK_URL=

##########################################################
# --- DevLake "Lake core" settings below, unmodified from upstream ---
##########################################################

PLUGIN_DIR=bin/plugins
REMOTE_PLUGIN_DIR=python/plugins

DB_URL=mysql://merico:merico@mysql:3306/lake?charset=utf8mb4&parseTime=True&loc=UTC
E2E_DB_URL=mysql://merico:merico@mysql:3306/lake_test?charset=utf8mb4&parseTime=True&loc=UTC
DB_LOGGING_LEVEL=Error
SKIP_SUBTASK_PROGRESS=false

PORT=8080
MODE=release

NOTIFICATION_ENDPOINT=
NOTIFICATION_SECRET=

API_TIMEOUT=120s
API_RETRY=3
API_REQUESTS_PER_HOUR=10000
PIPELINE_MAX_PARALLEL=1
RESUME_PIPELINES=true
LOGGING_LEVEL=
LOGGING_DIR=./logs
ENABLE_STACKTRACE=true
FORCE_MIGRATION=false

TAP_PROPERTIES_DIR=
DISABLED_REMOTE_PLUGINS=

# Left blank on purpose -- a real secret value must never live in a
# committed example file, even a "demo-only" one shared across every clone
# of this repo. `make demo`/`make up` (the `.env` Makefile target) generates
# a fresh random value here the first time `.env` is created from this file.
# This is the key DevLake uses to encrypt connection tokens/passwords at
# rest; if you create `.env` some other way, set it yourself: `python3 -c
# "import secrets; print(secrets.token_hex(16))"`.
ENCRYPTION_SECRET=

IN_SECURE_SKIP_VERIFY=false
ENDPOINT_CIDR_BLACKLIST=
FORBID_REDIRECTION=false

GITLAB_SERVER_COLLECT_ALL_USERS=true

USE_GO_GIT_IN_GIT_EXTRACTOR=false
SKIP_COMMIT_STAT=false
SKIP_COMMIT_FILES=true

WRAP_RESPONSE_ERROR=

ENABLE_SUBTASKS_BY_DEFAULT="jira:collectIssueChangelogs:true,jira:extractIssueChangelogs:true,jira:convertIssueChangelogs:true"
